{
  "name": "turnierplan-net",
  "version": "2026.3.0",
  "description": "The client application of turnierplan.NET",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/turnierplan-NET/turnierplan.NET"
  },
  "scripts": {
    "ng": "ng",
    "gen:api": "ng-openapi-gen --input ../obj/Turnierplan.App_turnierplan.json --output src/app/api --endOfLineStyle lf --enumStyle pascal --promises false --apiService TurnierplanApi --functionIndex \"\" --modelIndex \"\" && replace-in-file \"PublicId = any\" \"PublicId = string\" src/app/api/models/public-id.ts && replace-in-file \"/null/g\" \"undefined\" src/app/api/**/*",
    "gen:tp": "node actions.gen.js",
    "build:prod": "npm run gen:api && npm run gen:tp && npm run ng -- build --configuration production",
    "start": "npm run gen:api && npm run gen:tp && npm run ng -- serve --port 45001",
    "prettier": "prettier \"**/*.*css\" \"**/*.*js\" \"**/*.ts\" \"**/*.json\" \"**/*.html\"",
    "lint": "npm run prettier -- --write",
    "lint:ci": "npm run prettier -- --check",
    "test": "ng test",
    "test:ci": "ng test --watch=false --source-map=true --code-coverage --browsers ChromeHeadless",
    "e2e:swap-environment": "replace-in-file \"environment.prod.ts\" \"environment.e2e.ts\" angular.json",
    "e2e:swap-environment-back": "replace-in-file \"environment.e2e.ts\" \"environment.prod.ts\" angular.json",
    "e2e:prepare:amd64": "npx playwright install chromium && npm run e2e:swap-environment && docker compose -f e2e/docker/docker-compose.yaml up --build -d && npm run e2e:swap-environment-back",
    "e2e:destroy": "docker compose -f e2e/docker/docker-compose.yaml down",
    "e2e:open": "npx playwright test --ui",
    "e2e:run": "npx playwright test"
  },
  "dependencies": {
    "@angular/common": "~22.1.3",
    "@angular/compiler": "~22.1.3",
    "@angular/core": "~22.1.3",
    "@angular/forms": "~22.1.3",
    "@angular/localize": "~22.1.3",
    "@angular/platform-browser": "~22.1.3",
    "@angular/platform-browser-dynamic": "~22.1.3",
    "@angular/router": "~22.1.3",
    "@ng-bootstrap/ng-bootstrap": "~21.0.0",
    "@ngx-translate/core": "~18.0.0",
    "angularx-qrcode": "~22.0.1",
    "bootstrap": "~5.3.8",
    "bootstrap-icons": "~1.13.1",
    "core-js": "~3.50.0",
    "echarts": "~6.1.0",
    "jwt-decode": "~4.0.0",
    "ng2-pdfjs-viewer": "~26.4.2",
    "ngx-drag-drop": "~22.1.0",
    "ngx-echarts": "~22.0.0",
    "rxjs": "~7.8.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~22.1.5",
    "@angular/cli": "~22.1.5",
    "@angular/compiler-cli": "~22.1.3",
    "@playwright/test": "~1.62.1",
    "@types/jasmine": "~5.1.15",
    "@types/node": "~26.2.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-openapi-gen": "~1.0.5",
    "prettier": "~3.9.6",
    "replace-in-file": "~9.0.0",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
